    <div
      ref={ref}
      data-sidebar="group-label"
      className={cn(
        "flex h-4 shrink-0 items-center rounded-md px-0 text-[10px] font-medium uppercase tracking-normal text-neutral-400 overflow-hidden whitespace-nowrap transition-[margin,opacity] duration-200 ease-linear group-data-[collapsible=icon]:-mt-4 group-data-[collapsible=icon]:opacity-0",
        className
      )}
      {...props}
    />
