SidebarGroupContent.displayName = "SidebarGroupContent"

export const SidebarMenu = React.forwardRef<HTMLUListElement, React.ComponentProps<"ul">>(
  ({ className, ...props }, ref) => (
    <ul ref={ref} data-sidebar="menu" className={cn("flex w-full min-w-0 flex-col gap-[2px]", className)} {...props} />
  )
)
SidebarMenu.displayName = "SidebarMenu"

export const SidebarMenuItem = React.forwardRef<HTMLLIElement, React.ComponentProps<"li">>(
  ({ className, ...props }, ref) => (
    <li ref={ref} data-sidebar="menu-item" className={cn("group/menu-item relative", className)} {...props} />
  )
)
SidebarMenuItem.displayName = "SidebarMenuItem"

// NOTE: the `[&>span]:...` rules below are what actually fix the animation.
// Every direct <span> child of a menu button (your label AND your shortcut,
// since SidebarMenuShortcut renders a <span> too) gets a width/opacity/margin
// transition. When the sidebar collapses to icon-only, these spans shrink to
// 0 and fade out smoothly instead of just vanishing.
const sidebarMenuButtonVariants = cva(
  "peer/menu-button flex w-full items-center gap-[12px] overflow-hidden rounded-md px-4 py-1.5 text-left text-[12px] font-medium leading-none text-neutral-600 outline-none transition-colors hover:bg-neutral-100 hover:text-neutral-950 data-[active=true]:bg-neutral-100 data-[active=true]:text-neutral-950 [&>svg]:size-[13px] [&>svg]:shrink-0 [&>svg]:text-neutral-500 [&>span]:truncate [&>span]:whitespace-nowrap [&>span]:overflow-hidden [&>span]:transition-[width,opacity,margin] [&>span]:duration-200 [&>span]:ease-linear group-data-[collapsible=icon]:!size-8 group-data-[collapsible=icon]:!p-0 group-data-[collapsible=icon]:justify-center group-data-[collapsible=icon]:[&>span]:w-0 group-data-[collapsible=icon]:[&>span]:opacity-0 group-data-[collapsible=icon]:[&>span]:ml-0",
  {
    variants: {
      variant: { default: "", outline: "bg-background shadow-[0_0_0_1px_hsl(var(--sidebar-border))]" },
      size: { default: "h-[28px] text-[12px]", sm: "h-7 text-xs", lg: "h-11 text-sm group-data-[collapsible=icon]:!p-0" },
    },
    defaultVariants: { variant: "default", size: "default" },
  }
)

export const SidebarMenuButton = React.forwardRef<
  HTMLButtonElement,
  React.ComponentProps<"button"> & { asChild?: boolean; isActive?: boolean; tooltip?: string } & VariantProps<typeof sidebarMenuButtonVariants>
>(({ asChild = false, isActive = false, variant = "default", size = "default", tooltip, className, ...props }, ref) => {
  const Comp = asChild ? Slot : "button"
  const { state } = useSidebar()

  const button = (
    <Comp
      ref={ref}
      data-sidebar="menu-button"
      data-active={isActive}
      className={cn(sidebarMenuButtonVariants({ variant, size }), className)}
      {...props}
    />
  )

  if (!tooltip) return button

  return (
    <Tooltip>
      <TooltipTrigger asChild>{button}</TooltipTrigger>
      <TooltipContent side="right" align="center" hidden={state !== "collapsed"}>{tooltip}</TooltipContent>
    </Tooltip>
  )
})
SidebarMenuButton.displayName = "SidebarMenuButton"

// New: dedicated component for the right-aligned keyboard shortcut
// (the "V", "⌘Z", "⌘E" text in your screenshot). It's just a <span>,
// so it inherits the same hide/fade animation as the label automatically.
export const SidebarMenuShortcut = React.forwardRef<HTMLSpanElement, React.ComponentProps<"span">>(
  ({ className, ...props }, ref) => (
    <span
      ref={ref}
      data-sidebar="menu-shortcut"
      className={cn(
        "ml-auto text-xs tracking-widest text-neutral-400 pointer-events-none select-none",
        className
      )}
      {...props}
    />
  )
)
SidebarMenuShortcut.displayName = "SidebarMenuShortcut"

export const SidebarSeparator = React.forwardRef<HTMLDivElement, React.ComponentProps<"div">>(
  ({ className, ...props }, ref) => (
    <div ref={ref} data-sidebar="separator" className={cn("my-2 h-px w-auto bg-transparent", className)} {...props} />
  )
)
SidebarSeparator.displayName = "SidebarSeparator"

export const SidebarTrigger = React.forwardRef<HTMLButtonElement, React.ComponentProps<"button">>(
  ({ className, onClick, ...props }, ref) => {
    const { toggleSidebar } = useSidebar()
    return (
      <button ref={ref} data-sidebar="trigger" className={cn("inline-flex size-5 items-center justify-center rounded-md text-neutral-950 hover:bg-neutral-100 transition-colors", className)} onClick={(e) => { onClick?.(e); toggleSidebar() }} {...props}>
        <PanelLeft className="size-[13px] transition-transform duration-200" />
        <span className="sr-only">Toggle Sidebar</span>
      </button>
    )
  }
)
SidebarTrigger.displayName = "SidebarTrigger"

export const SidebarRail = React.forwardRef<HTMLButtonElement, React.ComponentProps<"button">>(
  ({ className, ...props }, ref) => {
    const { toggleSidebar } = useSidebar()
    return (
      <button ref={ref} data-sidebar="rail" aria-label="Toggle Sidebar" title="Toggle Sidebar" className={cn("absolute inset-y-0 right-0 z-20 w-1 cursor-ew-resize transition-all ease-linear hover:bg-neutral-200", className)} onClick={toggleSidebar} {...props} />
    )
  }
)
SidebarRail.displayName = "SidebarRail"
